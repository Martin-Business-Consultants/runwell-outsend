<% @page_title = "Outsend" %>
<%= render "settings/header", current: :outsend %>

<%# Saving the key swaps this frame in place, status included, rather than the page. %>
<turbo-frame id="outsend_settings">
<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">Mail through Outsend</h2>
      </header>

      <% if turbo_frame_request? && flash[:alert].present? %>
        <p class="txt-small txt-negative margin-none" role="alert"><%= flash[:alert] %></p>
      <% elsif turbo_frame_request? && flash[:notice].present? %>
        <p class="txt-small txt-positive margin-none" role="status"><%= flash[:notice] %></p>
      <% end %>

      <% source = Outsend::Connection.key_source %>
      <% if source %>
        <p class="txt-small margin-none">
          <%= status_tag "Active" %>
          Every email Runwell sends goes out through Outsend<%= { "environment" => ", with the key from the server’s environment (OUTSEND_API_KEY)", "credentials" => ", with the key from the encrypted credentials (outsend.api_key)" }[source] %>.
        </p>
      <% else %>
        <p class="txt-small margin-none"><%= status_tag "Dormant" %> No key yet: mail uses the server’s own SMTP settings, if any.</p>
      <% end %>

      <% if @connection.last_delivered_at %>
        <p class="txt-small txt-subtle margin-none">Last sent <%= time_ago_in_words(@connection.last_delivered_at) %> ago · <%= pluralize @connection.delivered_count, "message" %> so far.</p>
      <% end %>
      <% sender = Outsend::Connection.effective_sender %>
      <% if source && Outsend::Connection.unsendable_domain?(sender) %>
        <p class="txt-small txt-negative margin-none">Mail would come from <%= sender %>, which Outsend refuses: it sends only for domains verified in your Outsend account. Set who mail comes from in <%= link_to "Settings › Email", settings_email_path, class: "txt-link" %>.</p>
      <% end %>
      <% if @connection.last_error.present? %>
        <p class="txt-small txt-negative margin-none">Last failure<%= " " + time_ago_in_words(@connection.last_error_at) + " ago" if @connection.last_error_at %>: <%= @connection.last_error %></p>
      <% end %>

      <% if source %>
        <p class="txt-small txt-subtle margin-none">Send a test email from <%= link_to "Settings › Email", settings_email_path, class: "txt-link" %> to check it.</p>
      <% end %>
    </section>

    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">Who mail comes from</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">
        <%= Setting.current.mail_sender %>, Runwell’s sender (<%= link_to "Settings › Email", settings_email_path, class: "txt-link" %>). Outsend sends only from domains verified in your Outsend account, so use an address on one.
      </p>
    </section>

    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">API key</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">The key is from your Outsend account. It’s stored encrypted, and hidden here until you click the eye.</p>
      <%= form_with model: @connection, url: outsend_settings_path, method: :patch, scope: :connection, class: "flex flex-column gap txt-small" do |form| %>
        <label class="flex flex-column gap-half">
          <span class="font-weight-bold">API key</span>
          <%= secret_field form, :api_key, placeholder: (source && source != "settings" ? "Using the key from the #{source == "credentials" ? "encrypted credentials" : "server’s environment"}. Paste one to use it instead" : "Paste the API key") %>
        </label>
        <button type="submit" class="btn btn--link center">Save</button>
      <% end %>

      <% if @connection.api_key.present? %>
        <%= render "layouts/shared/confirm", trigger: "Forget the key", title: "Forget the Outsend key?",
              body: "Mail goes back to the server’s own SMTP settings, if any.", button: "Forget it", path: outsend_settings_path, icon: "remove" %>
      <% end %>
    </section>
  </div>
</section>
</turbo-frame>
